{
  "name": "ccprofile",
  "displayName": "ccprofile",
  "description": "在 Claude（Max 订阅，经本机 claude CLI）和其他模型之间切换的聊天面板",
  "version": "0.0.1",
  "publisher": "local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "compile": "node scripts/vendor.mjs && tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test test/*.test.mjs",
    "smoke": "npm run compile && node test/live-smoke.mjs",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "默认 bypassPermissions，会直接执行命令，只在受信任的工作区启用。"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ccprofile",
          "title": "ccprofile",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ccprofile": [
        {
          "type": "webview",
          "id": "ccprofile.chat",
          "name": "对话"
        }
      ]
    },
    "commands": [
      {
        "command": "ccprofile.newChat",
        "title": "新对话",
        "category": "ccprofile",
        "icon": "$(add)"
      },
      {
        "command": "ccprofile.stop",
        "title": "停止",
        "category": "ccprofile"
      },
      {
        "command": "ccprofile.switchProfile",
        "title": "切换模型",
        "category": "ccprofile"
      },
      {
        "command": "ccprofile.addProfile",
        "title": "添加模型（Base URL + API Key）",
        "category": "ccprofile"
      },
      {
        "command": "ccprofile.manageProfiles",
        "title": "管理模型",
        "category": "ccprofile",
        "icon": "$(gear)"
      },
      {
        "command": "ccprofile.doctor",
        "title": "自检",
        "category": "ccprofile"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ccprofile.newChat",
          "when": "view == ccprofile.chat",
          "group": "navigation@1"
        },
        {
          "command": "ccprofile.manageProfiles",
          "when": "view == ccprofile.chat",
          "group": "navigation@2"
        },
        {
          "command": "ccprofile.doctor",
          "when": "view == ccprofile.chat",
          "group": "more"
        }
      ]
    },
    "configuration": {
      "title": "ccprofile",
      "properties": {
        "ccprofile.claudePath": {
          "type": "string",
          "default": "~/.local/bin/claude",
          "description": "本机 claude CLI 的路径。从 Dock 启动的 VS Code 往往没有 ~/.local/bin 在 PATH 里，所以用绝对路径。"
        },
        "ccprofile.defaultPermissionMode": {
          "type": "string",
          "default": "bypassPermissions",
          "enum": [
            "bypassPermissions",
            "acceptEdits",
            "plan",
            "default",
            "dontAsk",
            "auto"
          ],
          "description": "每个窗口打开时的权限模式（对应 claude --permission-mode）。面板里可以临时切换。"
        },
        "ccprofile.profiles": {
          "type": "array",
          "default": [],
          "markdownDescription": "其他模型档位。一般用面板里的「＋ 添加模型…」来加；API Key 存在系统钥匙串，不在这里。内置的 `claude` 档（本机 `claude -p` + Max 订阅）不用写。",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "唯一 id；API Key 按它存进钥匙串。写 claude 可以覆盖内置 Claude 档（比如指定 model）。"
              },
              "label": {
                "type": "string",
                "description": "显示名称"
              },
              "baseUrl": {
                "type": "string",
                "description": "服务商的 Anthropic 兼容地址。不填就是 Claude 档：用本机 claude 的 /login 订阅。"
              },
              "model": {
                "type": "string",
                "description": "传给 claude --model；第三方档同时映射 opus / sonnet / haiku 三个别名。"
              },
              "authEnv": {
                "type": "string",
                "enum": [
                  "ANTHROPIC_AUTH_TOKEN",
                  "ANTHROPIC_API_KEY"
                ],
                "default": "ANTHROPIC_AUTH_TOKEN",
                "description": "API Key 放进哪个环境变量（AUTH_TOKEN 以 Bearer 头发送，API_KEY 以 X-Api-Key 头发送）。"
              },
              "models": {
                "type": "object",
                "description": "按别名分别指定模型，优先于 model。",
                "properties": {
                  "opus": {
                    "type": "string"
                  },
                  "sonnet": {
                    "type": "string"
                  },
                  "haiku": {
                    "type": "string",
                    "description": "后台任务（会话标题等）也用它。"
                  }
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "额外传给 claude 的环境变量。"
              }
            }
          }
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^3.9.2",
    "dompurify": "^3.4.17",
    "jsdom": "^26.1.0",
    "marked": "^15.0.12",
    "typescript": "~5.9"
  }
}
