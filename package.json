{
  "name": "ccprofile",
  "displayName": "CC Cadence",
  "description": "Chat in your editor with Claude (Max subscription via the local claude CLI) and any Anthropic-compatible model — switch models, keep the cadence.",
  "version": "0.0.15",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "compile": "node scripts/vendor.mjs && tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test test/*.test.mjs",
    "smoke": "npm run compile && node test/live-smoke.mjs",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Defaults to bypassPermissions and executes commands directly; only enable in trusted workspaces."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ccprofile",
          "title": "CC Cadence",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ccprofile": [
        {
          "type": "webview",
          "id": "ccprofile.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "ccprofile.newChat",
        "title": "New Chat",
        "category": "CC Cadence",
        "icon": "$(add)"
      },
      {
        "command": "ccprofile.stop",
        "title": "Stop",
        "category": "CC Cadence"
      },
      {
        "command": "ccprofile.switchProfile",
        "title": "Switch Model",
        "category": "CC Cadence"
      },
      {
        "command": "ccprofile.addProfile",
        "title": "Add Model (Base URL + API Key)",
        "category": "CC Cadence"
      },
      {
        "command": "ccprofile.manageProfiles",
        "title": "Manage Models",
        "category": "CC Cadence",
        "icon": "$(gear)"
      },
      {
        "command": "ccprofile.doctor",
        "title": "Doctor",
        "category": "CC Cadence"
      },
      {
        "command": "ccprofile.history",
        "title": "Session History",
        "category": "CC Cadence",
        "icon": "$(history)"
      },
      {
        "command": "ccprofile.open",
        "title": "Open CC Cadence in Editor",
        "category": "CC Cadence",
        "icon": "media/logo.svg"
      },
      {
        "command": "ccprofile.openHistory",
        "title": "Session History",
        "category": "CC Cadence",
        "icon": "$(history)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ccprofile.history",
          "when": "view == ccprofile.chat",
          "group": "navigation@0"
        },
        {
          "command": "ccprofile.newChat",
          "when": "view == ccprofile.chat",
          "group": "navigation@1"
        },
        {
          "command": "ccprofile.manageProfiles",
          "when": "view == ccprofile.chat",
          "group": "navigation@2"
        },
        {
          "command": "ccprofile.doctor",
          "when": "view == ccprofile.chat",
          "group": "more"
        }
      ],
      "editor/title": [
        {
          "command": "ccprofile.openHistory",
          "when": "activeWebviewPanelId == ccprofile.editor",
          "group": "navigation@0"
        },
        {
          "command": "ccprofile.open",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "CC Cadence",
      "properties": {
        "ccprofile.claudePath": {
          "type": "string",
          "default": "~/.local/bin/claude",
          "description": "Path to the local claude CLI. VS Code launched from the Dock often lacks ~/.local/bin in PATH, so use an absolute path."
        },
        "ccprofile.defaultPermissionMode": {
          "type": "string",
          "default": "bypassPermissions",
          "enum": [
            "bypassPermissions",
            "acceptEdits",
            "plan",
            "default",
            "dontAsk",
            "auto"
          ],
          "description": "Permission mode each window opens with (maps to claude --permission-mode). Can be switched temporarily in the panel."
        },
        "ccprofile.claudeEnv": {
          "type": "object",
          "default": {},
          "description": "Environment variables passed to every spawned claude process (e.g. CLAUDE_CODE_MAX_CONTEXT_TOKENS, CLAUDE_CODE_AUTO_COMPACT_WINDOW, API_TIMEOUT_MS). Profile-level env takes priority.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ccprofile.claudeSettings": {
          "type": "object",
          "default": {},
          "description": "Extra keys passed to claude via --settings (e.g. effortLevel). The model and effort picked in the panel's model menu take precedence.",
          "additionalProperties": true
        },
        "ccprofile.profiles": {
          "type": "array",
          "default": [],
          "markdownDescription": "Other model profiles. Usually added via \"＋ Add model…\" in the panel; API keys live in the system keychain, not here. The built-in `claude` profile (local `claude -p` + Max subscription) needs no entry.",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique id; the API key is stored in the keychain under it. Enter claude to override the built-in Claude profile (e.g. to pin a model)."
              },
              "label": {
                "type": "string",
                "description": "Display name"
              },
              "baseUrl": {
                "type": "string",
                "description": "Anthropic-compatible endpoint of the provider. Leave empty for the Claude profile: uses the local claude /login subscription."
              },
              "model": {
                "type": "string",
                "description": "Passed to claude --model; third-party profiles also map the opus / sonnet / haiku aliases to it."
              },
              "authEnv": {
                "type": "string",
                "enum": [
                  "ANTHROPIC_AUTH_TOKEN",
                  "ANTHROPIC_API_KEY"
                ],
                "default": "ANTHROPIC_AUTH_TOKEN",
                "description": "Which environment variable carries the API key (AUTH_TOKEN sends a Bearer header, API_KEY sends X-Api-Key)."
              },
              "models": {
                "type": "object",
                "description": "Per-alias model names; takes priority over model.",
                "properties": {
                  "opus": {
                    "type": "string"
                  },
                  "sonnet": {
                    "type": "string"
                  },
                  "haiku": {
                    "type": "string",
                    "description": "Also used for background tasks (session titles etc.)."
                  }
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra environment variables passed to claude."
              }
            }
          }
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^3.9.2",
    "dompurify": "^3.4.17",
    "jsdom": "^26.1.0",
    "marked": "^15.0.12",
    "typescript": "~5.9"
  },
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/keepwarehq/cc-cadence"
  }
}
